            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validation error: Max items', function () {",
                  "  pm.expect(pm.response.code).to.equal(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message || pm.response.text()).to.include('cannot exceed');",
