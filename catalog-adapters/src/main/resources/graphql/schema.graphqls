scalar BigDecimal
scalar DateTime


schema {
  query: Query
  mutation: Mutation
}


# ============================
#           TYPES
# ============================

type Product {
  id: ID!
  name: String!
  description: String
  price: BigDecimal!
  category: Category
  reviews: [Review!]!
  averageRating: Float
}

type Category {
  id: ID!
  name: String!
  parent: Category
}

type Review {
  id: ID!
  rating: Int!
  comment: String
  productId: ID!
  createdAt: DateTime!
}

type QualityIssue {
  id: ID!
  type: String!
  severity: String!
  status: String!
  createdAt: DateTime!
}

type CatalogReport {
  summary: CatalogSummary!
  productStats: [ProductStatistics!]!
  categoryStats: [CategoryStatistics!]!
}

type CatalogSummary {
  totalProducts: Int!
  totalCategories: Int!
  totalReviews: Int!
  totalQualityIssues: Int!
  averageProductPrice: BigDecimal
  overallAverageRating: Float
}

type ProductStatistics {
  productId: ID!
  productName: String!
  categoryId: ID
  categoryName: String
  price: BigDecimal!
  reviewCount: Int!
  averageRating: Float
  qualityIssueCount: Int!
}

type CategoryStatistics {
  categoryId: ID!
  categoryName: String!
  productCount: Int!
  reviewCount: Int!
  averageRating: Float
  averageProductPrice: BigDecimal
  qualityIssueCount: Int!
}

# ============================
#           QUERIES
# ============================

type Query {
  product(id: ID!): Product
  products: [Product!]!
  categories: [Category!]!
  catalogReport: CatalogReport!
}

# ============================
#          MUTATIONS
# ============================

type Mutation {
  createCategory(input: CreateCategoryInput!): Category!
  createProduct(input: CreateProductInput!): Product!
  updateProduct(input: UpdateProductInput!): Product!
  addReview(input: AddReviewInput!): Review!
  reportQualityIssue(input: ReportQualityIssueInput!): QualityIssue!
}

# ============================
#           INPUTS
# ============================

input CreateCategoryInput {
  name: String!
  parentId: ID
}

input CreateProductInput {
  name: String!
  description: String
  price: BigDecimal!
  categoryId: ID
}

input UpdateProductInput {
  id: ID!
  name: String
  description: String
  price: BigDecimal
  categoryId: ID
}

input AddReviewInput {
  productId: ID!
  rating: Int!
  comment: String
}

input ReportQualityIssueInput {
  productId: ID!
  type: String!
  severity: String!
}

