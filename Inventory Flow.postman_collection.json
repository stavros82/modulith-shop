{
  "info": {
    "_postman_id": "b2a9b65a-2d3b-4d1a-9b20-7f08f2c4d8c1",
    "name": "Inventory Flow",
    "description": "End-to-end Inventory flow driven by Catalog events: create category → create product → replenish stock → verify inventory → report quality issue → verify quarantine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Category (Catalog)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const id = pm.response.json().data.createCategory.id;",
              "pm.environment.set('categoryId', id);",
              "pm.test('Category created', function () { pm.expect(id).to.not.be.undefined; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"query\":\"mutation CreateCategory($input: CreateCategoryInput!) { createCategory(input: $input) { id name } }\",\"variables\":{\"input\":{\"name\":\"Electronics\",\"parentId\":null}}}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Product with Category (Catalog)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const id = pm.response.json().data.createProduct.id;",
              "pm.environment.set('productId', id);",
              "pm.test('Product created', function () { pm.expect(id).to.not.be.undefined; });",
              "pm.test('Product has category', function () {",
              "  pm.expect(pm.response.json().data.createProduct.category.id).to.eql(pm.environment.get('categoryId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"query\":\"mutation CreateProduct($input: CreateProductInput!) { createProduct(input: $input) { id name category { id name } } }\",\"variables\":{\"input\":{\"name\":\"Inventory Flow Product\",\"description\":\"Created by Inventory Flow\",\"price\":99.99,\"categoryId\":\"{{categoryId}}\"}}}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Get Inventory Product (REST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Inventory product returned', function () {",
              "  pm.expect(pm.response.json().productId).to.eql(pm.environment.get('productId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Replenish Stock (REST)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId}}/replenish?quantity=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId}}",
            "replenish"
          ],
          "query": [
            {
              "key": "quantity",
              "value": "100"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Report Quality Issue (Catalog)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"query\":\"mutation ReportQualityIssue($input: ReportQualityIssueInput!) { reportQualityIssue(input: $input) { id type severity status } }\",\"variables\":{\"input\":{\"productId\":\"{{productId}}\",\"type\":\"Defective Item\",\"severity\":\"High\"}}}"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. Get Inventory Product (should be UNSAFE/quarantined)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Inventory product is unsafe or quarantined', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.productId).to.eql(pm.environment.get('productId'));",
              "  pm.expect(body.safetyStatus).to.eql('UNSAFE');",
              "  pm.expect(Number(body.quarantinedQuantity)).to.be.greaterThan(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}

